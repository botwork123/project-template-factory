#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "Usage: $0 <project-name> <python|typescript|rust> [destination]"
  exit 1
fi

NAME="$1"
STACK="$2"
DEST_ROOT="${3:-$PWD}"

# stack-specific project-name validation
if [ "$STACK" = "python" ]; then
  if [[ ! "$NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "Invalid python project name: $NAME" >&2
    echo "Python names must match ^[A-Za-z_][A-Za-z0-9_]*$" >&2
    exit 1
  fi
elif [ "$STACK" = "typescript" ] || [ "$STACK" = "rust" ]; then
  if [[ ! "$NAME" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    echo "Invalid project name for $STACK: $NAME" >&2
    echo "Use letters, digits, '-' or '_' and start with a letter." >&2
    exit 1
  fi
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$SCRIPT_DIR/templates/$STACK"
DEST="$DEST_ROOT/$NAME"

if [ ! -d "$TEMPLATE_DIR" ]; then
  echo "Unknown stack: $STACK"
  exit 1
fi

if [ -e "$DEST" ]; then
  echo "Destination already exists: $DEST"
  exit 1
fi

cp -R "$TEMPLATE_DIR" "$DEST"

# token replacement (safe, portable)
find "$DEST" -type f -print0 | while IFS= read -r -d '' f; do
  python3 - "$f" "$NAME" <<'__PYTOK__'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
name = sys.argv[2]
path.write_text(path.read_text(encoding="utf-8").replace("__PROJECT_NAME__", name), encoding="utf-8")
__PYTOK__
done

# rename python package dir token if present
if [ -d "$DEST/src/__PROJECT_NAME__" ]; then
  mv "$DEST/src/__PROJECT_NAME__" "$DEST/src/$NAME"
fi

# create canonical agent instructions file
if [ ! -e "$DEST/AGENTS.md" ]; then
  cat > "$DEST/AGENTS.md" <<'EOF'
# AGENTS.md

Project-level instructions for coding agents.

- Follow `CODING_STANDARDS.md` when present.
- Prefer small, test-backed changes.
- Keep API changes explicit and documented.
EOF
fi

# scaffold CI + release workflows by stack (GitHub Actions)
mkdir -p "$DEST/.github/workflows"
if [ "$STACK" = "python" ]; then
  mkdir -p "$DEST/scripts"
  cat > "$DEST/scripts/detect_import_cycles.py" <<'EOF'
#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ast
from collections import defaultdict
from pathlib import Path


def build_graph(src_dir: Path, package: str) -> dict[str, set[str]]:
    graph: dict[str, set[str]] = defaultdict(set)
    modules: set[str] = set()

    for py in src_dir.rglob("*.py"):
        rel = py.relative_to(src_dir).with_suffix("")
        mod = package + "." + ".".join(rel.parts)
        modules.add(mod)

    for py in src_dir.rglob("*.py"):
        rel = py.relative_to(src_dir).with_suffix("")
        mod = package + "." + ".".join(rel.parts)
        tree = ast.parse(py.read_text(encoding="utf-8"))

        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                for alias in node.names:
                    tgt = alias.name
                    if tgt in modules:
                        graph[mod].add(tgt)
            elif isinstance(node, ast.ImportFrom):
                if node.level > 0:
                    parts = mod.split(".")
                    base = ".".join(parts[:-node.level])
                    suffix = node.module or ""
                    tgt = f"{base}.{suffix}".strip(".")
                else:
                    tgt = node.module or ""
                if tgt in modules:
                    graph[mod].add(tgt)

    for m in modules:
        graph.setdefault(m, set())
    return graph


def sccs(graph: dict[str, set[str]]) -> list[list[str]]:
    index = 0
    stack: list[str] = []
    on_stack: set[str] = set()
    indices: dict[str, int] = {}
    lowlink: dict[str, int] = {}
    comps: list[list[str]] = []

    def strongconnect(v: str) -> None:
        nonlocal index
        indices[v] = index
        lowlink[v] = index
        index += 1
        stack.append(v)
        on_stack.add(v)

        for w in graph[v]:
            if w not in indices:
                strongconnect(w)
                lowlink[v] = min(lowlink[v], lowlink[w])
            elif w in on_stack:
                lowlink[v] = min(lowlink[v], indices[w])

        if lowlink[v] == indices[v]:
            comp: list[str] = []
            while True:
                w = stack.pop()
                on_stack.remove(w)
                comp.append(w)
                if w == v:
                    break
            if len(comp) > 1:
                comps.append(sorted(comp))

    for node in sorted(graph):
        if node not in indices:
            strongconnect(node)

    return sorted(comps, key=lambda c: (len(c), c), reverse=True)


def load_baseline(path: Path) -> set[tuple[str, ...]]:
    if not path.exists():
        return set()
    groups: list[list[str]] = []
    current: list[str] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line:
            if current:
                groups.append(sorted(current))
                current = []
            continue
        current.append(line)
    if current:
        groups.append(sorted(current))
    return {tuple(g) for g in groups}


def write_baseline(path: Path, comps: list[list[str]]) -> None:
    body = []
    for comp in comps:
        body.extend(comp)
        body.append("")
    path.write_text("\n".join(body).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--src", default="src/__PROJECT_NAME__")
    ap.add_argument("--package", default="__PROJECT_NAME__")
    ap.add_argument("--baseline", default="scripts/import_cycle_baseline.txt")
    ap.add_argument("--fail-on", choices=["none", "any", "new"], default="new")
    ap.add_argument("--write-baseline", action="store_true")
    args = ap.parse_args()

    comps = sccs(build_graph(Path(args.src), args.package))
    baseline_path = Path(args.baseline)

    print(f"cycles={len(comps)}")
    for i, comp in enumerate(comps, 1):
        print(f"[cycle {i}]")
        for m in comp:
            print(f"  {m}")

    if args.write_baseline:
        baseline_path.parent.mkdir(parents=True, exist_ok=True)
        write_baseline(baseline_path, comps)
        print(f"wrote baseline: {baseline_path}")
        return 0

    if args.fail_on == "none":
        return 0
    if args.fail_on == "any":
        return 1 if comps else 0

    baseline = load_baseline(baseline_path)
    current = {tuple(c) for c in comps}
    new = sorted(current - baseline)
    if new:
        print(f"new_cycles={len(new)}")
        for comp in new:
            print("  new:")
            for m in comp:
                print(f"    {m}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
EOF
  chmod +x "$DEST/scripts/detect_import_cycles.py"
  : > "$DEST/scripts/import_cycle_baseline.txt"

  cat > "$DEST/.github/workflows/ci.yml" <<'EOF'
name: CI

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: curl -LsSf https://astral.sh/uv/0.7.9/install.sh | sh
      - run: echo "$HOME/.local/bin" >> $GITHUB_PATH
      - run: ./scripts/wt_bootstrap.sh
      - run: ./scripts/wt_run.sh ruff check .
      - run: ./scripts/wt_run.sh ruff format --check .
      - run: ./scripts/wt_run.sh mypy src/__PROJECT_NAME__
      - run: ./scripts/wt_run.sh python scripts/detect_import_cycles.py --fail-on new --baseline scripts/import_cycle_baseline.txt
      - run: ./scripts/wt_run.sh pytest --cov=src/__PROJECT_NAME__ --cov-fail-under=90
EOF

  cat > "$DEST/.github/workflows/release.yml" <<'EOF'
name: Release

on:
  push:
    tags:
      - "v*"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: python -m pip install --upgrade pip build
      - run: python -m build
      - run: ls -la dist
EOF
fi

if [ "$STACK" = "typescript" ]; then
  cat > "$DEST/.github/workflows/ci.yml" <<'EOF'
name: CI

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - run: npm ci
      - run: npm run -s build
      - run: npm test
EOF

  cat > "$DEST/.github/workflows/release.yml" <<'EOF'
name: Release

on:
  push:
    tags:
      - "v*"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - run: npm ci
      - run: npm pack
EOF
fi

if [ "$STACK" = "rust" ]; then
  cat > "$DEST/.github/workflows/ci.yml" <<'EOF'
name: CI

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo fmt -- --check
      - run: cargo clippy -- -D warnings
      - run: cargo test --all
EOF

  cat > "$DEST/.github/workflows/release.yml" <<'EOF'
name: Release

on:
  push:
    tags:
      - "v*"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo build --release
EOF
fi

# symlink common agent-specific instruction files to AGENTS.md
for alias in CLAUDE.md CURSOR.md CODEX.md GEMINI.md COPILOT.md; do
  if [ ! -e "$DEST/$alias" ]; then
    ln -s AGENTS.md "$DEST/$alias"
  fi
done

cd "$DEST"
git init >/dev/null

# Local PR-first guardrails: block direct pushes from protected branches.
mkdir -p .githooks
cat > .githooks/pre-push <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

# Allow explicit emergency bypass when absolutely necessary.
if [ "${ALLOW_PROTECTED_PUSH:-}" = "1" ]; then
  exit 0
fi

protected_branches_regex='^(main|master|release)$'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  branch="${local_ref#refs/heads/}"
  if [[ "$branch" =~ $protected_branches_regex ]]; then
    echo "❌ Push blocked: direct push to protected branch '$branch' is disabled locally."
    echo "   Create a feature branch + PR instead."
    echo "   Override once (emergency): ALLOW_PROTECTED_PUSH=1 git push ..."
    exit 1
  fi
done

exit 0
EOF
chmod +x .githooks/pre-push

git config core.hooksPath .githooks

if [ "$STACK" = "python" ]; then
  cat > .githooks/pre-commit <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "⚠️  pre-commit not found; install with: pip install pre-commit"
  exit 1
fi

pre-commit run --hook-stage pre-commit --all-files
EOF
  chmod +x .githooks/pre-commit
fi

git add .
if ! git commit -m "Bootstrap $STACK project $NAME from template" >/dev/null; then
  echo "Initial commit failed. Configure git user.name/user.email and retry." >&2
  exit 1
fi

echo "Created: $DEST"
echo "Local PR guard enabled: direct pushes to main/master/release are blocked by .githooks/pre-push"
if [ "$STACK" = "python" ]; then
  echo "Python hooks: .githooks/pre-commit runs pre-commit (requires local pre-commit binary)"
fi
